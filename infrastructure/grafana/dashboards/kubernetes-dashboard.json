{
  "title": "Kubernetes Cluster",
  "tags": ["k8s"],
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "title": "Running Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase='Running'})"
        }
      ]
    },
    {
      "title": "Node CPU %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100"
        }
      ]
    }
  ]
}